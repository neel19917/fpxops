# Railway env vars — set these in the Railway project settings.
# NEVER commit the real values; .env is gitignored.

# Anthropic (server-only)
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_LARGE=claude-sonnet-4-5-20250929

# Supabase (service role — bypasses RLS, server-only)
SUPABASE_URL=https://vvplkjgymahavqrejmgm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhb...

# CORS: comma-separated origins allowed to hit the API from a browser.
# For local dev add http://localhost:5173. For the deployed dashboard, add that origin too.
CORS_ORIGINS=chrome-extension://*,http://localhost:5173

# Optional: on startup, ensure this plaintext admin key exists in fpx_api_keys.
# Lets you bootstrap the first key without SQL. Remove after first boot or keep as a break-glass key.
# FPX_BOOTSTRAP_ADMIN_KEY=fpx_live_...

# Optional: on startup, promote this email's fpx_user_profiles row to admin + enabled.
# Idempotent — safe to leave set. Effective on next user login if profile doesn't exist yet.
# FPX_BOOTSTRAP_ADMIN_EMAIL=you@freightpop.com

PORT=3210
