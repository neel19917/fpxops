{
  "manifest_version": 3,
  "name": "FPXpress Tracking Refresh",
  "version": "3.5",
  "description": "Automates tracking refresh on the FPXpress dashboard with AI-powered issue analysis via Claude Haiku.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "nativeMessaging", "identity", "tabs"],
  "host_permissions": [
    "*://app.freightpop.com/*",
    "http://localhost:3210/*",
    "https://*.up.railway.app/*",
    "https://*.railway.app/*",
    "https://worldtimeapi.org/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://app.freightpop.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["inject-kendo.js", "inject-kendo-filter.js"],
    "matches": ["*://app.freightpop.com/*"]
  }]
}
